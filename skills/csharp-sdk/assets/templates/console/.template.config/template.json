{
  "$schema": "http://json.schemastore.org/template",
  "author": "Ditto",
  "classifications": [
    "Ditto",
    "Database",
    "console"
  ],
  "identity": "Ditto.CSharp.console",
  "name": "Ditto console task app",
  "shortName": "ditto-console",
  "sourceName": "DittoTasks",
  "preferNameDirectory": true,
  "symbols": {
    "ditto-version": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "5.2.0",
      "replaces": "DITTO_PACKAGE_VERSION",
      "description": "Exact stable Ditto version resolved from NuGet (5.x)."
    },
    "name-upper": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "name",
        "toLower": false
      },
      "replaces": "DITTOTASKS",
      "description": "Upper-case app name used as the environment-variable prefix (NAME_DATABASE_ID)."
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            "**/bin/**",
            "**/obj/**"
          ]
        }
      ],
      "rename": {
        "gitignore.in": ".gitignore"
      }
    }
  ]
}
