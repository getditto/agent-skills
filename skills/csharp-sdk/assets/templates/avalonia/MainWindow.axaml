<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:DittoTasks"
        x:Class="DittoTasks.MainWindow" x:DataType="local:TasksViewModel" Width="700" Height="480" Title="Ditto Tasks">
  <Grid Margin="20" RowDefinitions="Auto,*,Auto" RowSpacing="12">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBox x:Name="TitleInput" Width="200" PlaceholderText="Task title" />
      <Button Content="Add" Click="Add" /><Button Content="Save edit" Click="Edit" />
      <Button Content="Toggle done" Click="Toggle" /><Button Content="Delete" Click="Delete" />
    </StackPanel>
    <ListBox Grid.Row="1" x:Name="TasksList" ItemsSource="{Binding Items}" SelectionChanged="SelectTask">
      <ListBox.ItemTemplate><DataTemplate x:DataType="local:TaskItem"><StackPanel Orientation="Horizontal" Spacing="12">
        <CheckBox IsChecked="{Binding Done, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" />
        <TextBlock Text="{Binding Title}" />
      </StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" />
  </Grid>
</Window>
