<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TestTargetFramework Condition="'$(TestTargetFramework)' == ''">net10.0</TestTargetFramework>
    <TargetFramework>$(TestTargetFramework)</TargetFramework>
    <DittoVersion Condition="'$(DittoVersion)' == ''">5.2.0</DittoVersion>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants Condition="$(DittoVersion.StartsWith('4.'))">$(DefineConstants);DITTO_V4</DefineConstants>
    <DefineConstants Condition="$(DittoVersion.StartsWith('5.0.'))">$(DefineConstants);DITTO_50</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Ditto" Version="$(DittoVersion)" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="!$(DittoVersion.StartsWith('4.'))">
    <Compile Include="../../../skills/csharp-sdk/assets/common/*.cs" Link="Starter/%(Filename)%(Extension)" />
    <Compile Include="../../../skills/csharp-sdk/assets/modern/*.cs" Link="Modern/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
