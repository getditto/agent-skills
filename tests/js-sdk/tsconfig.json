{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "jsx": "react-jsx", "esModuleInterop": true,
    "skipLibCheck": true, "noEmit": true, "types": ["node"]
  },
  "include": [".generated/**/*.ts", ".generated/**/*.tsx", "test/**/*.ts", "browser/**/*.ts", "browser/**/*.tsx", "*.ts"]
}
