# Local test configuration for the agent-skills test harnesses.
#
# Copy this file to ".env" in the repo root and fill in real values:
#
#   cp .env-sample .env
#
# ".env" is gitignored — never commit real tokens. Variables already set in the
# environment (or CI secrets) always take precedence over this file. The
# harnesses load it automatically; to load it into your own shell instead:
#
#   set -a && . ./.env && set +a

# ---------------------------------------------------------------------------
# tests/dql — DQL skill harness (runs every documented query against real SDKs)
# ---------------------------------------------------------------------------

# Offline license token (REQUIRED — the harness exits immediately without it).
# Get one from https://portal.ditto.live (Settings -> Licenses). CI supplies
# this as the `DITTO_OFFLINE_LICENSE` repository secret.
# (Legacy alias also accepted by the runner: DITTO_PLAYGROUND_TOKEN)
DITTO_OFFLINE_LICENSE=

# Ditto database ID from the Ditto portal (OPTIONAL). The harness defaults to
# a fixed offline-playground UUID; only set this to point at a real database.
DITTO_DATABASE_ID=

# Note: DITTO_SDK_VERSION is set per-invocation by the npm scripts
# (`npm run test:v4` / `test:v5` / `test:v51`) — do not set it here.

# ---------------------------------------------------------------------------
# tests/data-modeling — live-model eval harness
# ---------------------------------------------------------------------------

# Shell command that reads a prompt on STDIN and writes the model's answer to
# STDOUT (REQUIRED unless running with --prompts-only). The harness pipes one
# eval prompt per case through it and captures stdout as the response.
# Full contract and examples: tests/data-modeling/README.md ("How
# DM_MODEL_CMD works").
# Examples:
#   DM_MODEL_CMD=claude -p
#   DM_MODEL_CMD=opencode run
#   DM_MODEL_CMD=gemini -p
DM_MODEL_CMD=
