# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
#
#   cp .env-sample .env
#
# Load it into your shell before running a test harness:
#
#   set -a && . ./.env && set +a

# ---------------------------------------------------------------------------
# tests/dql — required
# ---------------------------------------------------------------------------

# Offline license token for the Ditto SDK. Without this the harness exits
# immediately. Get one from https://portal.ditto.live (Settings -> Licenses).
# CI supplies this as the `DITTO_OFFLINE_LICENSE` repository secret.
DITTO_OFFLINE_LICENSE=

# ---------------------------------------------------------------------------
# tests/dql — optional
# ---------------------------------------------------------------------------

# Accepted as a fallback if DITTO_OFFLINE_LICENSE is unset.
# DITTO_PLAYGROUND_TOKEN=

# App / database identifier the test peer opens under. Defaults to a fixed
# throwaway UUID; only set this if you need to point at a specific database.
# DITTO_APP_ID=

# Note: DITTO_SDK_VERSION is set per-invocation by the npm scripts
# (`npm run test:v4` / `test:v5` / `test:v51`) — do not set it here.

# ---------------------------------------------------------------------------
# tests/data-modeling — required only for that harness
# ---------------------------------------------------------------------------

# Command used to invoke a model non-interactively, e.g. `claude -p` or
# `opencode`. Only needed if you are running the data-modeling evaluations.
# DM_MODEL_CMD=
